{
    "name": "dwivedianuj9118/laravel-ai-sarvam",
    "description": "Sarvam AI provider for the Laravel AI SDK: chat, text-to-speech and speech-to-text in Indian languages.",
    "keywords": ["laravel", "ai", "laravel-ai", "sarvam", "indic", "hindi", "tts", "stt"],
    "license": "MIT",
    "authors": [
        {
            "name": "Anuj Dwivedi",
            "email": "dwivedianuj9118@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/ai": "^1.3"
    },
    "require-dev": {
        "laravel/pint": "^1.26",
        "orchestra/testbench": "^10.6|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Dwivedianuj9118\\LaravelAiSarvam\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dwivedianuj9118\\LaravelAiSarvam\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dwivedianuj9118\\LaravelAiSarvam\\SarvamServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
